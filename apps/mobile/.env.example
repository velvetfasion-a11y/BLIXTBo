# Copy to apps/mobile/.env. Values are the same Firebase web app as blixtbo.se.
# EXPO_PUBLIC_ names are baked into the binary. Do not put landlord passwords or server secrets here.

EXPO_PUBLIC_API_URL=https://blixtbo.se/api
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_APPLE_PRODUCT_ID=se.blixtbo.premium.monthly

# Only for a local API on this machine. Never set this in a build that leaves your computer.
# EXPO_PUBLIC_ALLOW_INSECURE_API=1
