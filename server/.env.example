# Copy to .env and fill in. Never commit .env.

# Postgres on the same small VPS. For an even smaller box, use SQLite instead:
# DATABASE_URL=sqlite:////data/blixtbo.db
DATABASE_URL=postgresql+psycopg://blixtbo:change-me@db:5432/blixtbo
POSTGRES_PASSWORD=change-me

# Signs the session cookie. 32+ random bytes, hex.
APP_SECRET=replace-with-python-secrets-token-hex-32

# Wraps each user's data key. Only the worker process receives this.
# The API and the admin routes must leave it empty so they cannot decrypt logins.
# 32 bytes, base64. Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
WORKER_KEK=

# Seals a password before it is written to the job queue. The API has the public
# half only. The worker has the private half and re-encrypts under the user key.
# Generate both with:
# python -c "from blixtbo.crypto import generate_seal_keypair; print('\n'.join(generate_seal_keypair()))"
# Put the first line in WORKER_SEAL_PUBLIC (safe to give the API) and the second
# in WORKER_SEAL_PRIVATE (worker only). Compose clears the private key on the API.
WORKER_SEAL_PUBLIC=
WORKER_SEAL_PRIVATE=

OWNER_GOOGLE_EMAIL=owner@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback
PUBLIC_URL=https://your-domain.example

# Not linked from the app. Guessing it returns 404 until the owner is signed in.
ADMIN_PATH=/internal/ops

# Free model. No paid inference plan.
HF_MODEL=intfloat/multilingual-e5-small
HF_TOKEN=
MATCH_BACKEND=hf-inference

# dry-run does not open landlord sites. live calls each site's API or form.
# The worker reads this value. Compose does not pin it.
LANDLORD_MODE=dry-run

# Stripe secret or restricted key. sk_test_, rk_test_, sk_live_, or rk_live_. Empty and malformed keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preferred. When empty, the API looks up blixtbo_premium_monthly (99 kr/month) and creates it if missing.
STRIPE_PRICE_ID=
PREMIUM_PRICE_KR=99
TRIAL_DAYS=0
FREE_AUTO_APPLY_LIMIT=5
PUBLIC_APP_URL=http://127.0.0.1:43123

# Optional. Shown after a review of 4 or 5 stars. Leave empty to hide the button.
GOOGLE_REVIEW_URL=

# App data (users, swipes, applications, offers, queues, limits, encrypted
# landlord credentials) is Firestore. postgres keeps the worker job queue only.
DATA_BACKEND=firestore
FIREBASE_PROJECT_ID=

# Keep-alive mail. Leave empty until Zoho is set up: nothing is sent, and the
# worker logs mail_disabled once. Password and host stay on the server, not in git.
# SMTP_HOST=smtp.zoho.eu
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=support@blixtbo.se

# Optional hours between keep-alives for one landlord. Default is 24.
# Example: KEEPALIVE_INTERVAL_HOURS_HOMEQ=24
# One-line JSON of the service account. The worker needs it. The API uses it
# only to verify ID tokens and to write admin config. Do not give the API WORKER_KEK.
FIREBASE_SERVICE_ACCOUNT=

# Support mail. Leave SMTP_HOST empty to store tickets without sending.
# No paid mail service is included. Any SMTP server you already have is enough.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SUPPORT_EMAIL=support@blixtbo.se
# Escalations go here. Empty uses SUPPORT_EMAIL.
OWNER_ALERT_EMAIL=

# Optional in-app assistant. Empty means the chat shows the ticket form and calls no model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
