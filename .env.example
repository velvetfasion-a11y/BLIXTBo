# Copy to .env.local for the Next.js app. Never commit the filled-in file.

# Web config from Firebase console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Python API that checks the Firebase ID token. Leave empty to skip that call.
NEXT_PUBLIC_API_URL=

# true only on a machine running the Firebase emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=

# Shown in the app. The charge itself uses the server price.
NEXT_PUBLIC_PREMIUM_PRICE_KR=99
NEXT_PUBLIC_TRIAL_DAYS=3
NEXT_PUBLIC_FREE_AUTO_APPLY_LIMIT=2
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
