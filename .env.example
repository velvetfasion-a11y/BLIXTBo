# Copy to .env.local for the Next.js app. Never commit the filled-in file.

# Web config from Firebase console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Same-origin proxy to the FastAPI server. Production uses /api.
NEXT_PUBLIC_API_URL=/api
# Server-side only. Next rewrites /api/* to this origin.
API_PROXY_URL=http://127.0.0.1:8080

# true only on a machine running the Firebase emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=

# Shown in the app. The charge itself uses the server price.
NEXT_PUBLIC_PREMIUM_PRICE_KR=99
NEXT_PUBLIC_TRIAL_DAYS=3
NEXT_PUBLIC_FREE_AUTO_APPLY_LIMIT=2
# Stripe publishable key. pk_test_ or pk_live_. Other values are ignored.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
