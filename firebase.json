{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Blixtbo"
      }
    }
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8088 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  },
  "apphosting": {
    "backendId": "blixtbo",
    "rootDir": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server/**",
      "out/**",
      ".next/**"
    ]
  }
}
